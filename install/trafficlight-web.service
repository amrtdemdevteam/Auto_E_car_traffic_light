[Unit]
Description=E-Car Traffic Light Web UI (T3)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=trafficlightsvc
Group=trafficlightsvc
SupplementaryGroups=dialout
WorkingDirectory=/opt/trafficlight/raspberry_pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/trafficlight/raspberry_pi
ExecStart=/opt/trafficlight/.venv/bin/python -m trafficlight.web.server --data-dir /etc/trafficlight
Restart=always
RestartSec=3
# NoNewPrivileges must stay false: the "Reboot Pi" button runs
# `sudo -n /usr/bin/systemctl reboot` (the only command allowed in
# /etc/sudoers.d/trafficlight-web).
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/trafficlight /var/log/trafficlight

[Install]
WantedBy=multi-user.target
